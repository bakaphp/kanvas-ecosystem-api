<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ title }}{% if number %} {{ number }}{% endif %}</title>
    <style>
        @page { margin: 0; }
        body { margin: 0; padding: 40px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1f2933; }
        h1 { margin: 0; font-size: 26px; letter-spacing: 2px; text-transform: uppercase; color: #111827; }
        table { width: 100%; border-collapse: collapse; }
        .header td { vertical-align: top; }
        .logo { display: block; width: auto; height: auto; max-height: 40px; max-width: 160px; margin-bottom: 8px; }
        .issuer-name { font-size: 16px; font-weight: bold; }
        .muted { color: #6b7280; }
        .meta { margin-top: 4px; text-align: right; }
        .meta div { margin-bottom: 2px; }
        .status { display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 3px; background: #eef2f7; text-transform: uppercase; font-size: 10px; letter-spacing: 1px; }
        .bill-to { margin: 30px 0 20px; }
        .bill-to .label { text-transform: uppercase; font-size: 10px; letter-spacing: 1px; color: #6b7280; margin-bottom: 4px; }
        .lines { margin-top: 10px; }
        .lines th { text-align: left; border-bottom: 2px solid #1f2933; padding: 6px 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
        .lines td { padding: 8px 4px; border-bottom: 1px solid #e5e7eb; }
        .num { text-align: right; white-space: nowrap; }
        .totals { margin-top: 16px; width: 45%; margin-left: 55%; }
        .totals td { padding: 4px; }
        .totals .grand td { border-top: 2px solid #1f2933; font-weight: bold; font-size: 14px; }
        .notes { margin-top: 30px; }
        .notes .block { margin-bottom: 14px; }
        .notes .label { text-transform: uppercase; font-size: 10px; letter-spacing: 1px; color: #6b7280; margin-bottom: 3px; }
    </style>
</head>
<body>
<table class="header">
    <tr>
        <td>
            {% if issuer.logo %}<img class="logo" src="{{ issuer.logo }}" alt="{{ issuer.name }}">{% endif %}
            <div class="issuer-name">{{ issuer.name }}</div>
            {% for line in issuer.address_lines %}<div class="muted">{{ line }}</div>{% endfor %}
            {% if issuer.email %}<div class="muted">{{ issuer.email }}</div>{% endif %}
            {% if issuer.phone %}<div class="muted">{{ issuer.phone }}</div>{% endif %}
            {% if issuer.website %}<div class="muted">{{ issuer.website }}</div>{% endif %}
        </td>
        <td class="num">
            <h1>{{ title }}</h1>
            <div class="meta">
                <div><strong>{{ number|default('Draft') }}</strong></div>
                {% if issued_date %}<div class="muted">Issued {{ issued_date }}</div>{% endif %}
                {% if expiry_date %}<div class="muted">{{ expiry_label }} {{ expiry_date }}</div>{% endif %}
                <div class="status">{{ status|replace({'_': ' '}) }}</div>
            </div>
        </td>
    </tr>
</table>

<div class="bill-to">
    <div class="label">Bill to</div>
    <div><strong>{{ customer.name|default('No customer assigned') }}</strong></div>
    {% if customer.legal_name and customer.legal_name != customer.name %}<div class="muted">{{ customer.legal_name }}</div>{% endif %}
    {% if customer.attention %}<div class="muted">Attn: {{ customer.attention }}</div>{% endif %}
    {% for line in customer.address_lines %}<div class="muted">{{ line }}</div>{% endfor %}
    {% if customer.tax_id %}<div class="muted">Tax ID: {{ customer.tax_id }}</div>{% endif %}
    {% if customer.email %}<div class="muted">{{ customer.email }}</div>{% endif %}
</div>

<table class="lines">
    <thead>
    <tr>
        <th>Description</th>
        <th class="num">Qty</th>
        <th class="num">Unit price</th>
        <th class="num">Discount</th>
        <th class="num">Tax</th>
        <th class="num">Amount</th>
    </tr>
    </thead>
    <tbody>
    {% for line in lines %}
        <tr>
            <td>
                {{ line.description }}
                {% if line.sku %}<div class="muted">{{ line.sku }}</div>{% endif %}
            </td>
            <td class="num">{{ line.quantity|number_format(2)|replace({'.00': ''}) }}</td>
            <td class="num">{{ line.unit_price|number_format(2) }}</td>
            <td class="num">{{ line.discount|number_format(2) }}</td>
            <td class="num">{{ line.tax|number_format(2) }}</td>
            <td class="num">{{ line.total|number_format(2) }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<table class="totals">
    <tr>
        <td>Subtotal</td>
        <td class="num">{{ currency }} {{ totals.subtotal|number_format(2) }}</td>
    </tr>
    {% if totals.discount > 0 %}
        <tr>
            <td>Discount</td>
            <td class="num">- {{ currency }} {{ totals.discount|number_format(2) }}</td>
        </tr>
    {% endif %}
    <tr>
        <td>Tax</td>
        <td class="num">{{ currency }} {{ totals.tax|number_format(2) }}</td>
    </tr>
    <tr class="grand">
        <td>Total</td>
        <td class="num">{{ currency }} {{ totals.total|number_format(2) }}</td>
    </tr>
    {% if totals.paid is not null and totals.paid > 0 %}
        <tr>
            <td>Paid</td>
            <td class="num">- {{ currency }} {{ totals.paid|number_format(2) }}</td>
        </tr>
        <tr class="grand">
            <td>Balance due</td>
            <td class="num">{{ currency }} {{ totals.balance_due|number_format(2) }}</td>
        </tr>
    {% endif %}
</table>

{% if notes or terms %}
    <div class="notes">
        {% if notes %}
            <div class="block">
                <div class="label">Notes</div>
                <div>{{ notes|nl2br }}</div>
            </div>
        {% endif %}
        {% if terms %}
            <div class="block">
                <div class="label">Terms</div>
                <div>{{ terms|nl2br }}</div>
            </div>
        {% endif %}
    </div>
{% endif %}
</body>
</html>
