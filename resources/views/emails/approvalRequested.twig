<tr>
    <td style="padding: 24px 12px; font-family: Arial, sans-serif; color: #263238;">
        <h1 style="margin: 0 0 8px; font-size: 22px; line-height: 1.3;">Approval needed</h1>
        <p style="margin: 0 0 20px; color: #667085; font-size: 14px;">
            {{ company_name ?? 'Your company' }} · a request is waiting on your decision.
        </p>

        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; margin-bottom: 20px; background: #f4f7fb; border-radius: 6px;">
            <tr>
                <td style="padding: 16px;">
                    <div style="font-size: 12px; color: #667085;">{{ approval.type }}</div>
                    <strong style="display: block; margin: 4px 0 8px; font-size: 18px;">{{ approval.name }}</strong>
                    <div style="font-size: 14px;">{{ approval.action }}</div>
                    <div style="margin-top: 4px; font-size: 12px; color: #667085;">Requested {{ approval.requested_at }}</div>
                </td>
            </tr>
        </table>

        {% if review_url %}
            <p style="margin: 0;">
                <a href="{{ review_url }}" style="display: inline-block; background: #1d4ed8; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px;">Review approval</a>
            </p>
        {% endif %}
    </td>
</tr>
