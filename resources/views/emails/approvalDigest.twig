<tr>
    <td style="padding: 24px 12px; font-family: Arial, sans-serif; color: #263238;">
        <h1 style="margin: 0 0 8px; font-size: 22px; line-height: 1.3;">{{ count }} approvals waiting for you</h1>
        <p style="margin: 0 0 20px; color: #667085; font-size: 14px;">
            {{ company_name ?? 'Your company' }} · these requests are waiting on your decision.
        </p>

        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; margin-bottom: 20px;">
            <tr>
                <th align="left" style="padding: 8px; border-bottom: 2px solid #eaecf0; font-size: 12px; color: #667085;">Record</th>
                <th align="left" style="padding: 8px; border-bottom: 2px solid #eaecf0; font-size: 12px; color: #667085;">Action</th>
                <th align="left" style="padding: 8px; border-bottom: 2px solid #eaecf0; font-size: 12px; color: #667085;">Requested</th>
            </tr>
            {% for approval in approvals %}
                <tr>
                    <td style="padding: 10px 8px; border-bottom: 1px solid #eaecf0; font-size: 14px;">
                        <strong>{{ approval.name }}</strong><br>
                        <span style="color: #667085; font-size: 12px;">{{ approval.type }}</span>
                    </td>
                    <td style="padding: 10px 8px; border-bottom: 1px solid #eaecf0; font-size: 14px;">{{ approval.action }}</td>
                    <td style="padding: 10px 8px; border-bottom: 1px solid #eaecf0; font-size: 13px; color: #667085;">{{ approval.requested_at }}</td>
                </tr>
            {% endfor %}
        </table>

        {% if review_url %}
            <p style="margin: 0;">
                <a href="{{ review_url }}" style="display: inline-block; background: #1d4ed8; color: #ffffff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px;">Review approvals</a>
            </p>
        {% endif %}
    </td>
</tr>
